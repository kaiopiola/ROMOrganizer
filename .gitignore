node_modules/
dist/
out/
build/
release/
coverage/
*.tsbuildinfo

# O `build/` acima ignora saídas de build, mas `apps/desktop/build/` é o diretório de
# recursos do electron-builder — o ícone mora ali e é fonte, tem que ir versionado. Sem isto
# ele não chega ao CI e o app sai com o ícone padrão do Electron.
!apps/desktop/build/
!apps/desktop/build/**

.DS_Store
Thumbs.db

.env
.env.*
!.env.example

# Nunca versionar ROMs, BIOS ou DATs de terceiros. Ver README > Escopo legal.
*.nes
*.sfc
*.smc
*.gb
*.gbc
*.gba
*.md
!README*.md
!CONTRIBUTING*.md
!TODO.md
!docs/**/*.md
!changelog/*.md
!.github/**/*.md
*.n64
*.v64
*.z64
*.bin
*.iso
*.chd
*.dat

